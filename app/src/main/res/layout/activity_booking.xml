<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="72dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="6dp"
                android:text="Book a Gym Session"
                android:textColor="@color/primary_blue"
                android:textSize="26sp"
                android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp"
            android:text="Gym operating hours: 5:00 AM – 11:00 PM"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <!-- Split Label -->

        <!-- Split Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="❖  Select Your Workout Split"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            style="@style/GymCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white">

            <Spinner
                android:id="@+id/spinnerSplit"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:padding="20dp" />

        </androidx.cardview.widget.CardView>

        <!-- Split Description -->
        <TextView
            android:id="@+id/tvSplitDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Custom Split -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCustomSplit"
            style="@style/GymCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white">

            <EditText
                android:id="@+id/etCustomSplit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Describe your focus (e.g. Chest + Abs)"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:padding="16dp"
                android:textSize="15sp" />

        </androidx.cardview.widget.CardView>

        <!-- Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="❖  Select Date"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Date Picker -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDatePicker"
            style="@style/GymCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:padding="20dp"
                android:text="Tap to select date"
                android:textColor="@color/primary_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

        <!-- Time Slot Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="❖  Select Time Slot"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Time Slot Spinner Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTimeSlot"
            style="@style/GymCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Available Gym Sessions"
                    android:textColor="@color/dark_gray"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerTimeSlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Slot Status -->
        <TextView
            android:id="@+id/tvSlotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Rules -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="• Max capacity per time slot\n• 1 active booking per member\n• Time slots are first-come first-served\n• Full slots automatically use waitlist\n• Check out by scanning QR at the staff desk"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <!-- Confirm Button -->
            <Button
                android:id="@+id/btnConfirmBooking"
                style="@style/GymButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="CONFIRM BOOKING" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/nav_bottom_user" />

</LinearLayout>
