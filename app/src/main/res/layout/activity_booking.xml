<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="6dp"
            android:text="Book a Gym Session"
            android:textColor="@color/primary_blue"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp"
            android:text="Gym open: 5:00 AM – 12:00 AM"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <!-- Split Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="💪 Select Your Workout Split"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Split Spinner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            app:cardBackgroundColor="@color/white">

            <Spinner
                android:id="@+id/spinnerSplit"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:padding="20dp" />

        </androidx.cardview.widget.CardView>

        <!-- Split description hint -->
        <TextView
            android:id="@+id/tvSplitDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Custom split input — visible only when Custom is selected -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCustomSplit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white">

            <EditText
                android:id="@+id/etCustomSplit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe your focus (e.g. Chest + Abs)"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:padding="16dp"
                android:textSize="15sp"
                android:background="@null" />

        </androidx.cardview.widget.CardView>

        <!-- Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="📅 Select Date (Mon–Sat)"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Date Picker Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDatePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="Tap to select date"
                android:textColor="@color/primary_blue"
                android:textSize="17sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false" />

        </androidx.cardview.widget.CardView>

        <!-- Arrival Time Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="🕐 Planned Arrival Time"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Time Picker Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTimePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white">

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="Tap to set arrival time"
                android:textColor="@color/primary_blue"
                android:textSize="17sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false" />

        </androidx.cardview.widget.CardView>

        <!-- Daily capacity status label -->
        <TextView
            android:id="@+id/tvSlotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Rules -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="• Max 30 bookings per day\n• 1 booking per day per member\n• No bookings on Sundays\n• Gym open 5:00 AM – 12:00 AM\n• Check out by scanning QR at the staff desk"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <!-- Confirm Button -->
        <Button
            android:id="@+id/btnConfirmBooking"
            style="@style/GymButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="CONFIRM BOOKING" />

    </LinearLayout>
</ScrollView>