<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"
            android:text="Book 1-Hour Session"
            android:textColor="@color/primary_blue"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Workout Type Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🏋 Select Workout Type"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Workout Type Spinner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            app:cardBackgroundColor="@color/white">

            <Spinner
                android:id="@+id/spinnerWorkout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:padding="20dp" />

        </androidx.cardview.widget.CardView>

        <!-- Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Select Date (Mon-Sat only)"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Date Picker Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDatePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="📆 Tap to select date"
                android:textColor="@color/primary_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false" />

        </androidx.cardview.widget.CardView>

        <!-- Time Slot Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Time Slot (8AM - 7PM)"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Time Slot Spinner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GymCard"
            app:cardBackgroundColor="@color/white">

            <Spinner
                android:id="@+id/spinnerTime"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:padding="20dp" />

        </androidx.cardview.widget.CardView>

        <!-- Slot Availability Status (shown after date is selected) -->
        <TextView
            android:id="@+id/tvSlotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:background="@android:color/transparent" />

        <!-- Rules note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="* Max 15 users per slot&#10;* 1 booking per day&#10;* No bookings on Sundays&#10;* Full slots → automatic waitlist (FIFO)"
            android:textColor="@color/gray"
            android:textSize="14sp" />

        <!-- Confirm Button -->
        <Button
            android:id="@+id/btnConfirmBooking"
            style="@style/GymButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="CONFIRM BOOKING" />

    </LinearLayout>
</ScrollView>