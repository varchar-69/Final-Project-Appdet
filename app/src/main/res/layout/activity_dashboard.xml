<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="48dp"
        android:text="Welcome!"
        android:textColor="@color/primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBookSession"
            style="@style/GymButton"
            android:text="📅 Book Gym Session" />

        <Button
            android:id="@+id/btnBookingHistory"
            style="@style/GymButton"
            android:text="📋 Booking History" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBMI"
            style="@style/GymButton"
            android:text="⚖️ BMI Calculator" />

        <Button
            android:id="@+id/btnWorkouts"
            style="@style/GymButton"
            android:text="💪 Workout Programs" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnFeedback"
            style="@style/GymButton"
            android:text="⭐ Gym Feedback" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/GymButton"
            android:backgroundTint="@color/error"
            android:text="🚪 Logout" />

    </LinearLayout>

</LinearLayout>