<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Step bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <View android:layout_width="0dp" android:layout_height="3dp"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:background="@color/primary_blue" />
            <View android:layout_width="0dp" android:layout_height="3dp"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:background="@color/primary_blue" />
            <View android:layout_width="0dp" android:layout_height="3dp"
                android:layout_weight="1" android:background="@color/primary_blue" />
        </LinearLayout>

        <!-- Header -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Complete registration" android:textColor="@color/dark_gray"
            android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fill in your details to create your account."
            android:textColor="@color/medium_gray" android:textSize="14sp"
            android:layout_marginBottom="28dp" />

        <!-- SECTION: Account -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ACCOUNT" android:textColor="@color/medium_gray"
            android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Username + Full Name -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:hint="Username *"
                app:errorEnabled="true"
                app:boxStrokeColor="@color/primary_blue"
                app:hintTextColor="@color/medium_gray"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFullName"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:hint="Full Name *"
                app:errorEnabled="true"
                app:boxStrokeColor="@color/primary_blue"
                app:hintTextColor="@color/medium_gray"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:hint="Email *"
            app:errorEnabled="true"
            app:boxStrokeColor="@color/primary_blue"
            app:hintTextColor="@color/medium_gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="0dp" android:hint="Password *"
            app:errorEnabled="true"
            app:passwordToggleEnabled="true"
            app:boxStrokeColor="@color/primary_blue"
            app:hintTextColor="@color/medium_gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            PASSWORD STRENGTH INDICATOR
            Visibility toggled to VISIBLE as soon as the user types.
            Three bar segments light up progressively: Weak / Medium / Strong.
        -->
        <LinearLayout
            android:id="@+id/layoutPasswordStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="2dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- Three-segment bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <View android:id="@+id/segmentOne"
                    android:layout_width="0dp" android:layout_height="5dp"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    android:background="#E0E0E0" />
                <View android:id="@+id/segmentTwo"
                    android:layout_width="0dp" android:layout_height="5dp"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    android:background="#E0E0E0" />
                <View android:id="@+id/segmentThree"
                    android:layout_width="0dp" android:layout_height="5dp"
                    android:layout_weight="1" android:background="#E0E0E0" />
            </LinearLayout>

            <!-- Strength label + hint text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tvStrengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvStrengthHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="11sp"
                    android:textColor="@color/medium_gray" />
            </LinearLayout>

        </LinearLayout>

        <!-- Confirm Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:hint="Confirm Password *"
            app:errorEnabled="true"
            app:passwordToggleEnabled="true"
            app:boxStrokeColor="@color/primary_blue"
            app:hintTextColor="@color/medium_gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="@color/light_border" android:layout_marginBottom="20dp" />

        <!-- SECTION: Personal Info -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PERSONAL INFO" android:textColor="@color/medium_gray"
            android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Gender label -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gender *" android:textColor="@color/medium_gray"
            android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

        <!-- Gender toggle buttons (unchanged) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">

            <LinearLayout android:id="@+id/btnMale"
                android:layout_width="0dp" android:layout_height="80dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/radio_selector"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/imgMale"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_male" android:layout_marginBottom="6dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Male" android:textColor="@color/dark_gray"
                    android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnFemale"
                android:layout_width="0dp" android:layout_height="80dp"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:background="@drawable/radio_selector"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/imgFemale"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_female" android:layout_marginBottom="6dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Female" android:textColor="@color/dark_gray"
                    android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Contact Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContact"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:hint="Contact Number *"
            app:errorEnabled="true"
            app:boxStrokeColor="@color/primary_blue"
            app:hintTextColor="@color/medium_gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContact"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone" android:maxLength="11" android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="11 digits, starting with 09"
            android:textColor="@color/medium_gray" android:textSize="11sp"
            android:layout_marginBottom="12dp" android:layout_marginStart="4dp" />

        <!-- Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" android:hint="Address *"
            app:errorEnabled="true"
            app:boxStrokeColor="@color/primary_blue"
            app:hintTextColor="@color/medium_gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPostalAddress" android:lines="2" android:padding="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="@color/light_border" android:layout_marginBottom="20dp" />

        <!-- SECTION: Emergency Contact -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_background"
            android:padding="16dp" android:layout_marginBottom="28dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EMERGENCY CONTACT" android:textColor="@color/medium_gray"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="14dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmergencyName"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:hint="Contact Name *"
                    app:errorEnabled="true"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/medium_gray"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmergencyName"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPersonName" android:padding="14dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmergencyContact"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:hint="Contact Number *"
                    app:errorEnabled="true"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/medium_gray"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmergencyContact"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="phone" android:maxLength="11" android:padding="14dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="11 digits" android:textColor="@color/medium_gray"
                android:textSize="11sp" android:layout_marginTop="4dp"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Register Button -->
        <Button android:id="@+id/btnRegister"
            style="@style/GymButton"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:text="COMPLETE REGISTRATION" />

    </LinearLayout>
</ScrollView>
