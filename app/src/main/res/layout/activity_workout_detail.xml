<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWorkoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"
            android:text="Workout Name"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="⚙️ Equipment Preferences"
            android:textColor="@color/primary_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView style="@style/GymCard" app:cardBackgroundColor="@color/white">
            <CheckBox
                android:id="@+id/cbDumbbells"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gold"
                android:padding="20dp"
                android:text="💪 Dumbbells" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView style="@style/GymCard" app:cardBackgroundColor="@color/white">
            <CheckBox
                android:id="@+id/cbBarbell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gold"
                android:padding="20dp"
                android:text="🏋️ Barbell" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView style="@style/GymCard" app:cardBackgroundColor="@color/white">
            <CheckBox
                android:id="@+id/cbBench"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gold"
                android:padding="20dp"
                android:text="🛏️ Bench Press" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView style="@style/GymCard" app:cardBackgroundColor="@color/white">
            <CheckBox
                android:id="@+id/cbPullup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gold"
                android:padding="20dp"
                android:text="🧗 Pull-up Bar" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView style="@style/GymCard" app:cardBackgroundColor="@color/white">
            <CheckBox
                android:id="@+id/cbTreadmill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gold"
                android:padding="20dp"
                android:text="🏃 Treadmill" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView style="@style/GymCard" app:cardBackgroundColor="@color/white">
            <CheckBox
                android:id="@+id/cbWeights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gold"
                android:padding="20dp"
                android:text="⚖️ Free Weights" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSavePreferences"
            style="@style/GymButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE PREFERENCES" />

    </LinearLayout>

</ScrollView>