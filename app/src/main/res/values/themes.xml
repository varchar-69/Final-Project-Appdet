<resources>
    <!-- Main App Theme -->
    <style name="Theme.SpotterMobile" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- FIX: Changed from DayNight.DarkActionBar to Light.NoActionBar -->
        <!-- DayNight was causing hints to render white in dark mode -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
        <item name="colorSurface">@color/white</item>

        <!-- FIX: These control hint and text colors on surfaces -->
        <item name="colorOnSurface">@color/dark_gray</item>
        <item name="colorOnBackground">@color/dark_gray</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:textColor">@color/dark_gray</item>
    </style>

    <!-- Gym Buttons -->
    <style name="GymButton" parent="Widget.MaterialComponents.Button">
      <!--  <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item> -->
        <item name="android:layout_margin">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary_blue</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Gold Buttons -->
    <style name="GoldButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Card Style -->
    <style name="GymCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <!-- FIX: Custom TextInputLayout style so hints are never overridden to white -->
    <style name="CustomTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/primary_blue</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="boxStrokeColor">@color/primary_blue</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>